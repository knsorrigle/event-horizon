{
  "name": "event-horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "tsc -p . && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr --emptyOutDir && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "gen:bluenoise": "node scripts/gen-bluenoise.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-glsl": "^1.6.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
